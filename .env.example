# ─────────────────────────────────────────────────────────────
# POWER MEDIA — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Public site URL (optional). Used for auth email links and metadata.
# If unset, auth links use the request's own host (works on Vercel).
NEXT_PUBLIC_SITE_URL=

# ── Supabase ─────────────────────────────────────────────────
# Project URL + publishable key are safe for the browser (protected by RLS).
# Works with the new `sb_publishable_…` keys and legacy anon JWT keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key bypasses RLS — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Works with the new `sb_secret_…` keys and legacy service_role JWT keys.
# Needed for: sending team invite emails and removing members.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers (Phase 3) — SERVER ONLY ─────────────────────
# Which provider the /api/ai/* routes use: "anthropic" | "openai"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Payments (Phase 4) — SERVER ONLY except publishable keys ─
# Stripe for international cards; Paymob / Moyasar / Tap for EG & GCC local methods.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=

# ── Email (contact form notifications) — SERVER ONLY ─────────
RESEND_API_KEY=
CONTACT_INBOX_EMAIL=

# Dev only: allow viewing the dashboard without Supabase configured.
# Ignored when NODE_ENV=production.
DASHBOARD_PREVIEW_MODE=true
